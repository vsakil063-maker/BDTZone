<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="20dp">

    <!-- Top Bar with Back Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="32dp">
        
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/text_white"/>
            
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Deposit"
            android:textColor="@color/text_white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp"/>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Payment Method"
        android:textColor="@color/text_white"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginBottom="16dp"/>

    <!-- Nagad Button -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardNagad"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        app:cardBackgroundColor="@color/nagad_red"
        app:cardCornerRadius="12dp"
        android:layout_marginBottom="12dp">
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nagad"
            android:textColor="@color/text_white"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_gravity="center"/>
    </androidx.cardview.widget.CardView>

    <!-- bKash Button -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardBkash"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        app:cardBackgroundColor="@color/bkash_pink"
        app:cardCornerRadius="12dp"
        android:layout_marginBottom="12dp">
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="bKash"
            android:textColor="@color/text_white"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_gravity="center"/>
    </androidx.cardview.widget.CardView>

    <!-- Binance Button -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardBinance"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        app:cardBackgroundColor="@color/binance_yellow"
        app:cardCornerRadius="12dp"
        android:layout_marginBottom="24dp">
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Binance"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_gravity="center"/>
    </androidx.cardview.widget.CardView>

    <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>

    <Button
        android:id="@+id/btnProceed"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Proceed"
        android:textColor="@color/bg_dark"
        android:background="@drawable/bg_btn_primary"
        android:textStyle="bold"
        android:textSize="16sp"/>

</LinearLayout>
